# AI model used to analyze tool results.
LLM_PROVIDER=openai
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=your_model_name
# Set to 1 only when the configured model and compatible endpoint accept image input.
LLM_VISION_ENABLED=0
# Supported values: auto, low, high.
LLM_VISION_DETAIL=high

# Market research shortcuts: /stock, /forex, /crypto
TWELVE_DATA_API_KEY=your_twelve_data_key

# Market research shortcut: /macro
FRED_API_KEY=your_fred_api_key

# Optional market news enrichment for the daily market briefing
FINNHUB_API_KEY=your_finnhub_api_key
MARKET_OVERVIEW_REFRESH_SECONDS=30
DAILY_MARKET_BRIEFING_REFRESH_MINUTES=15

# Optional live Web Search in the AI assistant
TAVILY_API_KEY=your_tavily_api_key

# Notifications (Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_secret
TELEGRAM_WEBHOOK_BASE_URL=https://your-antitrade-api.example
APP_PUBLIC_URL=https://your-antitrade-app.example

# Stripe subscriptions. Create one recurring monthly Price and one yearly Price
# in Stripe, then register /api/billing/webhook as an HTTPS webhook endpoint.
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_signing_secret
STRIPE_PRO_MONTHLY_PRICE_ID=price_your_monthly_price
STRIPE_PRO_YEARLY_PRICE_ID=price_your_yearly_price
# Display metadata in minor currency units (900 = USD 9.00).
BILLING_CURRENCY=USD
BILLING_PRO_MONTHLY_AMOUNT=900
BILLING_PRO_YEARLY_AMOUNT=9000
# Calendar-month AI usage allowances.
BILLING_FREE_AI_UNITS=20
BILLING_PRO_AI_UNITS=300
# Durable user automation tasks
AUTOMATION_TASKS_ENABLED=1
AUTOMATION_POLL_SECONDS=30
# Required when account MFA is enabled. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# Google Identity Services OAuth 2.0 Web client ID. The same public client ID is
# returned to the frontend by /api/auth/google/config.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
